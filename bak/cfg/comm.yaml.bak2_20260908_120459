# =============================================================
# comm.yaml — 通信与运动决策参数（串口帧 / DOF 映射 / 心跳急停 /
#             运动预设与速度阈值 / PID / 任务使能与时序 / 边界条件）
# =============================================================

serial:
  device: /dev/ttyS1
  baud: 9600

frame:                     # 11B：0xA5 + 7轴 + 3键（模拟遥控，详见 docs/CUP_AUV）
  header: 165              # 0xA5
  axis_count: 7
  btn_count: 3
  axis_mid: 128
  axis_range: 127
  aux_axis: {4: 165, 5: 1, 6: 1}   # axis4=滚轮静止/中值, axis5/6=tri 中位
  btn_values: [0, 0, 0]    # 当前下位机固件未使用

dof_map:                   # DOF→轴字节真值表（下位机 RC_Translate）
  surge: {axis: 1, sign: 1}   # 前后 ← LY
  sway:  {axis: 3, sign: 1}   # 左右平移 ← RY
  heave: {axis: 2, sign: 1}   # 升降 ← RX
  yaw:   {axis: 0, sign: 1}   # 旋转 ← LX

heartbeat:
  interval_ms: 50          # ≥20Hz（下位机当前无帧超时停车 → 必须持续心跳）
estop:
  repeat_ms: 30            # 急停连发中性帧间隔
ramp:
  speed_per_s: 220.0       # 轴字节平滑速率（0=关闭）

motion:                    # 动作/速度预设（归一化 DOF：surge,sway,heave,yaw）
  search_yaw: -0.6         # 无目标时原地旋转搜索
  loss_inertia_surge: 0.25 # 目标短时丢失时的低速惯性
  presets:
    stop:         [0.0, 0.0, 0.0, 0.0]
    forward_fast: [1.0, 0.0, 0.0, 0.0]
    forward_slow: [0.35, 0.0, 0.0, 0.0]
    backward:     [-0.5, 0.0, 0.0, 0.0]
    left:         [0.0, -1.0, 0.0, 0.0]
    right:        [0.0, 1.0, 0.0, 0.0]
    up:           [0.0, 0.0, 1.0, 0.0]
    down:         [0.0, 0.0, -1.0, 0.0]
    turn_left:    [0.0, 0.0, 0.0, -0.6]
    turn_right:   [0.0, 0.0, 0.0, 0.6]
    search:       [0.0, 0.0, 0.0, -0.6]

tasks:
  enabled: [ball, back]    # gate 规则细化后再启用
  fault_action: skip       # 模型缺失等：skip | exit
  idle_ms: 1000
  done_hold_ms: 500

ball:                      # 面积占比分级（视觉量 → 运动决策）
  ema_alpha: 0.3
  lost_grace_frames: 15
  r_slow: 0.12
  r_near: 0.30
  r_hit: 0.75
  hit_confirm_frames: 5
  growth_eps: 0.002
  align_x: true            # 视觉居中：x → sway
  align_y: true            # 视觉居中：y → heave
  timeout_ms: 300000
  pid: {kp: 0.9, ki: 0.05, kd: 0.15, out_max: 0.6, deadzone: 0.04}

back:                      # 返回出发区（下视红线相位机）
  timeout_ms: 300000
  align_deadzone: 0.10
  align_min_frames: 5
  travel_correct_th: 0.22
  line_lost_finish_frames: 25

gate:                      # 过门（现阶段禁用，规则细化后启用）
  timeout_ms: 300000
  pass_target: 4
  align_deadzone: 0.1
  pass_area_threshold: 0.6

debug:                     # 通信调试
  tx_frame_hex: true        # 终端打印每次发出的 11B 运动帧（真串口下）
  tx_frame_log_ms: 0        # 打印节流（毫秒；0=发一次打一次）
