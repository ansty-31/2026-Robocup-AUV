# -*- coding: utf-8 -*-
"""tasks.py — PID 与三大任务（ball/back/gate）集中实现

- PID：位置式（视觉居中用，死区清零积分、限幅防 windup）
- BallTask   任务一 撞球：面积占比分级调速 + 视觉居中 PID
- BackTask   任务二 返回出发区：下视红线颜色检测 + 相位机
- GateTask   任务三 过门（现阶段禁用，规则细化后启用）
阈值/增益等参数一律在 cfg/comm.yaml（settings 读取）
"""

import numpy as np

import settings as S

try:
    import cv2
    HAS_CV2 = True
except ImportError:
    HAS_CV2 = False


def _dx_norm(cx, w):
    """球心/目标中心 X 相对画面中心的归一化偏差。"""
    return (cx - w / 2.0) / (w / 2.0)


def _dy_norm(cy, h):
    return (cy - h / 2.0) / (h / 2.0)


class PID(object):
    def __init__(self, kp=1.0, ki=0.0, kd=0.0,
                 out_min=-1.0, out_max=1.0, deadzone=0.0):
        self.kp = kp
        self.ki = ki
        self.kd = kd
        self.out_min = out_min
        self.out_max = out_max
        self.deadzone = deadzone
        self._last_err = 0.0
        self._integral = 0.0
        self._last_t = None
        self.last_out = 0.0

    def reset(self):
        self._last_err = 0.0
        self._integral = 0.0
        self._last_t = None
        self.last_out = 0.0

    def update(self, error, now_ms=None):
        if now_ms is None:
            dt = 0.05
        else:
            if self._last_t is None:
                dt = 0.05
            else:
                dt = max(0.001, (now_ms - self._last_t) / 1000.0)
            self._last_t = now_ms
        if abs(error) <= self.deadzone:
            self._integral = 0.0
            self._last_err = error
            self.last_out = 0.0
            return 0.0
        self._integral += error * dt
        lim = max(0.5 * (self.out_max - self.out_min), 0.5)
        self._integral = max(-lim, min(lim, self._integral))
        deriv = (error - self._last_err) / dt if dt > 0 else 0.0
        self._last_err = error
        out = self.kp * error + self.ki * self._integral + self.kd * deriv
        self.last_out = max(self.out_min, min(self.out_max, out))
        return self.last_out

class BallTask(object):
    name = "ball"

    def __init__(self, uart, hub, frame_w, frame_h):
        self.uart = uart
        self.hub = hub
        self.w = frame_w
        self.h = frame_h
        self.frames = 0
        self._start_ms = None
        self._ema = None
        self._seen = False
        self._lost_cnt = 0
        self._hit_cnt = 0
        pid_kw = dict(kp=S.comm.ball.pid.kp, ki=S.comm.ball.pid.ki,
                      kd=S.comm.ball.pid.kd,
                      out_min=-S.comm.ball.pid.out_max,
                      out_max=S.comm.ball.pid.out_max,
                      deadzone=S.comm.ball.pid.deadzone)
        self._pid_x = PID(**pid_kw)
        self._pid_y = PID(**pid_kw)
        self.last_info = {"action": "stop", "ratio": 0.0, "growth": 0.0,
                          "dx": 0.0, "dy": 0.0, "sway": 0.0, "heave": 0.0,
                          "surge": 0.0,
                          "status": S.STATUS_RUNNING, "reason": ""}

    @property
    def ready(self):
        return self.hub.ready(self.name)

    # ------------------------------------------------------------------ 辅助
    def _ema_update(self, r):
        if self._ema is None:
            self._ema = r
            return 0.0
        prev = self._ema
        self._ema = (1 - S.comm.ball.ema_alpha) * self._ema + \
                    S.comm.ball.ema_alpha * r
        return self._ema - prev

    def _surge_plan(self, r, g):
        """面积占比分级 → 前进目标（归一化）+ 阶段标签（供日志/测试）。"""
        if r >= S.comm.ball.r_hit:
            return 0.0, "stop"
        if r >= S.comm.ball.r_near:
            return 0.35, "forward_slow"
        if r >= S.comm.ball.r_slow:
            if g > S.comm.ball.growth_eps:
                return 1.0, "forward_fast"
            return 0.35, "forward_slow"
        return 1.0, "forward_fast"

    def _center_ctl(self, cx, cy, now_ms):
        """球心相对画面中心的归一化偏差 → PID → (sway, heave) 目标。"""
        dx = (cx - self.w / 2.0) / (self.w / 2.0)
        dy = (cy - self.h / 2.0) / (self.h / 2.0)
        px = self._pid_x.update(dx, now_ms) if S.comm.ball.align_x else 0.0
        py = self._pid_y.update(dy, now_ms) if S.comm.ball.align_y else 0.0
        # 偏差在右/下 → 需向左/上修正：DOF 输出取反
        return dx, dy, -px, -py

    # ------------------------------------------------------------------ 主入口
    def process(self, frame, now_ms):
        self.frames += 1
        if self._start_ms is None:
            self._start_ms = now_ms
        if not self.ready:
            return S.STATUS_DONE

        det = self.hub.detect(self.name, frame)
        ratio = det.ratio(self.w, self.h) if det is not None else 0.0
        growth = self._ema_update(ratio)

        surge = 0.0
        label = "search"
        dx = dy = sway = heave = 0.0
        if det is not None:
            self._seen = True
            self._lost_cnt = 0
            cx, cy = det.center
            surge, label = self._surge_plan(self._ema or 0.0, growth)
            if label == "stop":
                self._hit_cnt += 1
            if surge > 0:
                dx, dy, sway, heave = self._center_ctl(cx, cy, now_ms)
            else:
                self._pid_x.reset()
                self._pid_y.reset()
        else:
            if self._seen and self._ema is not None and \
                    self._ema >= S.comm.ball.r_near:
                self._hit_cnt += 1            # 近距消失 = 越球
                label = "stop"
            elif self._seen and self._lost_cnt < S.comm.ball.lost_grace_frames:
                self._lost_cnt += 1
                surge = 0.25                   # 短时丢失：低速保持惯性
                label = "forward_slow"
            else:
                self._lost_cnt += 1            # 未见/长丢：原地旋转搜索

        # 直接下发 DOF（模拟遥控）：前进 + 居中修正，搜索用 yaw 旋转
        if label == "search":
            self.uart.send_dof(0.0, 0.0, 0.0, S.comm.motion.search_yaw)
        else:
            self.uart.send_dof(surge, sway, heave, 0.0)

        status = S.STATUS_RUNNING
        reason = ""
        if self._hit_cnt >= S.comm.ball.hit_confirm_frames:
            status, reason = S.STATUS_DONE, "hit"
        elif self._start_ms is not None and \
                now_ms - self._start_ms >= S.comm.ball.timeout_ms:
            status, reason = S.STATUS_DONE, "timeout"

        self.last_info.update({
            "action": label, "ratio": round(self._ema or 0.0, 4),
            "growth": round(growth, 4), "dx": round(dx, 4),
            "dy": round(dy, 4), "sway": round(sway, 4),
            "heave": round(heave, 4), "surge": round(surge, 3),
            "status": status, "reason": reason})
        if S.DEBUG and status == S.STATUS_DONE:
            print("[BALL] DONE(%s) %s r=%.3f sway=%.2f frames=%d"
                  % (reason, label, self._ema or 0, sway, self.frames))
        return status

class BackTask(object):
    name = "back"
    PHASE_SEARCH = "SEARCH"
    PHASE_ALIGN = "ALIGN"
    PHASE_TRAVEL = "TRAVEL"

    def __init__(self, uart, hub, frame_w, frame_h):
        self.uart = uart
        self.hub = hub            # 预留：未来可融合 line 模型；当前仅用颜色逻辑
        self.w = frame_w
        self.h = frame_h
        self.frames = 0
        self._start_ms = None
        self.phase = self.PHASE_SEARCH
        self._align_cnt = 0
        self._lost_cnt = 0
        self._ever_on_line = False
        self.last_info = {"phase": self.phase, "dx": 0.0, "area": 0.0,
                          "action": "search", "status": S.STATUS_RUNNING,
                          "reason": ""}

    @property
    def ready(self):
        return True                # 纯颜色逻辑，无需模型

    # ------------------------------------------------------------ 颜色检测
    def _find_line(self, frame):
        """返回 (found, dx_norm, area_ratio)。dx∈[-1,1]，负=线在左。"""
        if frame is None:
            return False, 0.0, 0.0
        h, w = frame.shape[:2]
        if HAS_CV2:
            hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
            m1 = cv2.inRange(hsv, (S.vision.color.line_red.hsv.h1[0], S.vision.color.line_red.hsv.s_min,
                                   S.vision.color.line_red.hsv.v_min),
                             (S.vision.color.line_red.hsv.h1[1], 255, 255))
            m2 = cv2.inRange(hsv, (S.vision.color.line_red.hsv.h2[0], S.vision.color.line_red.hsv.s_min,
                                   S.vision.color.line_red.hsv.v_min),
                             (S.vision.color.line_red.hsv.h2[1], 255, 255))
            mask = cv2.bitwise_or(m1, m2)
            k = np.ones((3, 3), np.uint8)
            mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, k)
            mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, k)
        else:
            r = frame[..., 2].astype(np.int16)
            g = frame[..., 1].astype(np.int16)
            b = frame[..., 0].astype(np.int16)
            mask = ((r > S.vision.color.line_red.rgb.r_min) & (g < S.vision.color.line_red.rgb.g_max) &
                    (b < S.vision.color.line_red.rgb.b_max)).astype(np.uint8)
        area_ratio = float(mask.mean())
        if area_ratio < S.vision.color.line_red.min_area_ratio:
            return False, 0.0, area_ratio
        col = mask.sum(axis=0).astype(np.float64)          # 每列命中数
        total = col.sum()
        if total <= 0:
            return False, 0.0, area_ratio
        cx = float((np.arange(w) * col).sum() / total)
        dx = (cx - (w - 1) / 2.0) / ((w - 1) / 2.0)        # 归一化 [-1,1]
        return True, dx, area_ratio

    # ------------------------------------------------------------ 主入口
    def process(self, frame, now_ms):
        self.frames += 1
        if self._start_ms is None:
            self._start_ms = now_ms

        found, dx, area = self._find_line(frame)

        if self.phase == self.PHASE_SEARCH:
            if found:
                self.phase = self.PHASE_ALIGN
                self._align_cnt = 0
                self._ever_on_line = True
            action = "search"
        else:                                              # ALIGN / TRAVEL
            if found:
                self._lost_cnt = 0
                if abs(dx) <= S.comm.back.align_deadzone:
                    self._align_cnt += 1
                    if self.phase == self.PHASE_TRAVEL:
                        action = "forward_slow"            # 沿线直行
                    elif self._align_cnt >= S.comm.back.align_min_frames:
                        self.phase = self.PHASE_TRAVEL     # 对中完成，开始沿线
                        action = "forward_slow"
                    else:
                        action = "stop"                    # 对中阶段：只转向不前进
                else:
                    self._align_cnt = 0
                    action = "left" if dx < 0 else "right" # 对中/行进中修正
            else:
                self._lost_cnt += 1
                if self.phase == self.PHASE_TRAVEL and \
                        self._lost_cnt >= S.comm.back.line_lost_finish_frames:
                    # 沿线中线的末端消失 → 到达出发区
                    self.uart.neutral()
                    self.last_info.update({"phase": self.phase, "dx": dx,
                                           "area": round(area, 5),
                                           "action": "stop",
                                           "status": S.STATUS_DONE,
                                           "reason": "line_end"})
                    if S.DEBUG:
                        print("[BACK] DONE(line_end) frames=%d" % self.frames)
                    return S.STATUS_DONE
                action = "search"                          # 丢线：重新搜索

        self.uart.set_motion(action)

        status = S.STATUS_RUNNING
        reason = ""
        if self._start_ms is not None and \
                now_ms - self._start_ms >= S.comm.back.timeout_ms:
            status, reason = S.STATUS_DONE, "timeout"
            self.uart.neutral()
        self.last_info.update({"phase": self.phase, "dx": round(dx, 4),
                               "area": round(area, 5), "action": action,
                               "status": status, "reason": reason})
        return status

class GateTask(object):
    name = "gate"

    def __init__(self, uart, hub, frame_w, frame_h):
        self.uart = uart
        self.hub = hub
        self.w = frame_w
        self.h = frame_h
        self.frames = 0
        self._start_ms = None
        self._pass_cnt = 0
        self._was_large = False
        self._seen = False
        self.last_info = {"dx": 0.0, "dy": 0.0, "pass": 0,
                          "action": "stop", "status": S.STATUS_RUNNING,
                          "reason": ""}

    @property
    def ready(self):
        return self.hub.ready(self.name)

    def process(self, frame, now_ms):
        self.frames += 1
        if self._start_ms is None:
            self._start_ms = now_ms
        if not self.ready:
            return S.STATUS_DONE

        det = self.hub.detect(self.name, frame)
        action = "stop"
        if det is not None:
            self._seen = True
            cx, cy = det.center
            dx = (cx - self.w / 2.0) / (self.w / 2.0)
            dy = (cy - self.h / 2.0) / (self.h / 2.0)
            ratio = det.ratio(self.w, self.h)

            # 穿门计数：面积曾超阈值后消失
            if ratio >= S.comm.gate.pass_area_threshold:
                self._was_large = True
            # 离散对准（PID 后续替换）
            if abs(dx) > S.comm.gate.align_deadzone:
                action = "right" if dx > 0 else "left"
            elif abs(dy) > S.comm.gate.align_deadzone:
                action = "down" if dy > 0 else "up"
            else:
                action = "forward_slow"
        else:
            dx = dy = 0.0
            if self._was_large and self._seen:
                self._pass_cnt += 1            # 大框消失 = 穿过一个门
                self._was_large = False
                print("[GATE] pass %d/%d" % (self._pass_cnt, S.comm.gate.pass_target))

        self.uart.set_motion(action)

        status, reason = S.STATUS_RUNNING, ""
        if self._pass_cnt >= S.comm.gate.pass_target:
            status, reason = S.STATUS_DONE, "4_gates"
            self.uart.neutral()
        elif self._start_ms is not None and \
                now_ms - self._start_ms >= S.comm.gate.timeout_ms:
            status, reason = S.STATUS_DONE, "timeout"
            self.uart.neutral()
        self.last_info.update({"dx": dx, "dy": dy, "pass": self._pass_cnt,
                               "action": action, "status": status,
                               "reason": reason})
        return status